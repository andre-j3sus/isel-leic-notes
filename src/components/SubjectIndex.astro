---
import type { Subject, Semester } from '@lib/navigation';
import { GITHUB_REPO_URL } from '@lib/navigation';

export interface NoteCard {
  number: number | null;
  title: string;
  href: string;
}

export interface PdfResource {
  title: string;
  href: string;
}

interface Props {
  subject: Subject;
  semester: Semester;
  notes: NoteCard[];
  pdfs: PdfResource[];
}

const { subject, semester, notes, pdfs } = Astro.props;

// Sort notes by number, then alphabetically
const sortedNotes = [...notes].sort((a, b) => {
  if (a.number !== null && b.number !== null) {
    return a.number - b.number;
  }
  if (a.number !== null) return -1;
  if (b.number !== null) return 1;
  return a.title.localeCompare(b.title);
});

const githubUrl = `${GITHUB_REPO_URL}/${subject.path}`;
---

<div class="subject-index">
  <header class="subject-header">
    <div class="header-top">
      <div class="title-section">
        <span class="subject-code">{subject.code}</span>
        <h1 class="subject-name">{subject.name}</h1>
        <p class="subject-name-pt">{subject.namePt}</p>
      </div>
      <a href={githubUrl} class="github-link" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
    </div>
    <div class="subject-meta">
      <span class="meta-item">{semester.name}</span>
      <span class="meta-separator">-</span>
      <span class="meta-item">6 ECTS</span>
    </div>
  </header>

  {sortedNotes.length > 0 ? (
    <section class="notes-section">
      <h2 class="section-title">Notes</h2>
      <ul class="notes-list">
        {sortedNotes.map((note) => (
          <li>
            <a href={note.href} class="note-row">
              {note.number !== null && (
                <span class="note-number">{note.number}</span>
              )}
              <span class="note-title">{note.title}</span>
              <svg class="note-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="empty-section">
      <p>No markdown notes available for this subject yet.</p>
    </section>
  )}

  {pdfs.length > 0 && (
    <section class="resources-section">
      <h2 class="section-title">Resources</h2>
      <ul class="resources-list">
        {pdfs.map((pdf) => (
          <li>
            <a href={pdf.href} class="resource-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span class="resource-title">{pdf.title}</span>
              <span class="pdf-badge">PDF</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
  .subject-index {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .subject-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .title-section {
    flex: 1;
  }

  .subject-code {
    display: inline-block;
    background-color: var(--isel-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .subject-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.25rem 0;
    line-height: 1.2;
  }

  .subject-name-pt {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
    font-style: italic;
  }

  .github-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .github-link:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    text-decoration: none;
  }

  .subject-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .meta-separator {
    color: var(--text-muted);
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
  }

  .notes-section {
    margin-bottom: 2rem;
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
  }

  .notes-list li {
    border-bottom: 1px solid var(--border-color);
  }

  .notes-list li:last-child {
    border-bottom: none;
  }

  .note-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: background-color 0.15s;
  }

  .note-row:hover {
    background-color: var(--bg-secondary);
    text-decoration: none;
  }

  .note-number {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    background-color: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .note-title {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .note-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s, transform 0.15s;
  }

  .note-row:hover .note-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .empty-section {
    padding: 1rem;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--text-muted);
    background-color: var(--bg-secondary);
    border-radius: 8px;
  }

  .empty-section p {
    margin: 0;
  }

  .resources-section {
    margin-bottom: 2rem;
  }

  .resources-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .resource-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.875rem;
    transition: border-color 0.15s;
  }

  .resource-link:hover {
    border-color: var(--isel-primary);
    text-decoration: none;
  }

  .resource-link svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .resource-title {
    flex: 1;
  }

  .pdf-badge {
    padding: 0.125rem 0.5rem;
    background-color: var(--bg-primary);
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .subject-index {
      padding: 1rem;
    }

    .header-top {
      flex-direction: column;
    }

    .github-link {
      align-self: flex-start;
    }

    .subject-name {
      font-size: 1.5rem;
    }
  }
</style>
