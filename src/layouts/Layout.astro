---
import '@/styles/global.css';
import ThemeToggle from '@components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Notes from BSc in Computer Science and Computer Engineering at ISEL' } = Astro.props;
const fullTitle = title === 'Home' ? 'ISEL LEIC Notes' : `${title} | ISEL LEIC Notes`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <title>{fullTitle}</title>
    
    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.setAttribute('data-theme', theme);
        }
      })();
    </script>
  </head>
  <body>
    <header class="header">
      <div class="header-content">
        <div class="header-left">
          <button class="sidebar-toggle-mobile" id="sidebar-toggle-mobile" aria-label="Toggle navigation menu">
            <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          <a href="/" class="logo">
            <span class="logo-icon">ISEL</span>
            <span class="logo-text">LEIC Notes</span>
          </a>
        </div>
        <div class="header-actions">
          <a href="https://github.com/andre-j3sus/isel-leic-notes" class="github-link" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span class="github-text">GitHub</span>
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    
    <slot />
    
    <!-- Sidebar expand button (shown when collapsed on desktop) -->
    <button class="sidebar-expand-btn" id="sidebar-expand-btn" aria-label="Expand sidebar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    
    <footer class="footer">
      <div class="footer-content">
        <p>
          Notes by <a href="https://andrejesus.com" target="_blank" rel="noopener noreferrer">André Jesus</a>
          &bull; BSc in Computer Science and Computer Engineering at 
          <a href="https://www.isel.pt/en" target="_blank" rel="noopener noreferrer">ISEL</a> (2020-2023)
        </p>
        <p class="footer-disclaimer">
          These notes are intended as a summary and are not meant to replace official course materials.
        </p>
        <p class="footer-hosted">
          Hosted on <a href="https://workers.cloudflare.com/" target="_blank" rel="noopener noreferrer">Cloudflare Workers</a>
        </p>
      </div>
    </footer>
    
    <script>
      // Sidebar state management
      function initSidebar() {
        const html = document.documentElement;
        const mobileToggle = document.getElementById('sidebar-toggle-mobile');
        const expandBtn = document.getElementById('sidebar-expand-btn');
        const backdrop = document.getElementById('sidebar-backdrop');
        
        // Load saved desktop collapsed state
        const savedCollapsed = localStorage.getItem('sidebar-collapsed');
        if (savedCollapsed === 'true') {
          html.setAttribute('data-sidebar-collapsed', '');
        }
        
        // Mobile toggle
        mobileToggle?.addEventListener('click', () => {
          if (html.hasAttribute('data-sidebar-open')) {
            html.removeAttribute('data-sidebar-open');
            document.body.style.overflow = '';
          } else {
            html.setAttribute('data-sidebar-open', '');
            document.body.style.overflow = 'hidden';
          }
        });
        
        // Desktop expand button
        expandBtn?.addEventListener('click', () => {
          html.removeAttribute('data-sidebar-collapsed');
          localStorage.setItem('sidebar-collapsed', 'false');
        });
        
        // Close mobile sidebar on backdrop click
        backdrop?.addEventListener('click', () => {
          html.removeAttribute('data-sidebar-open');
          document.body.style.overflow = '';
        });
        
        // Close mobile sidebar on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && html.hasAttribute('data-sidebar-open')) {
            html.removeAttribute('data-sidebar-open');
            document.body.style.overflow = '';
          }
        });
      }
      
      // Initialize on page load
      initSidebar();
      
      // Re-initialize on Astro page transitions
      document.addEventListener('astro:page-load', initSidebar);
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
  }
  
  .header-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }
  
  .logo:hover {
    text-decoration: none;
  }
  
  .logo-icon {
    background-color: var(--isel-primary);
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.875rem;
  }
  
  .logo-text {
    font-weight: 600;
    font-size: 1.125rem;
  }
  
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .github-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: background-color 0.2s, color 0.2s;
  }
  
  .github-link:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    text-decoration: none;
  }
  
  .github-text {
    font-size: 0.875rem;
  }
  
  .sidebar-toggle-mobile {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    border-radius: 6px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  
  .sidebar-toggle-mobile:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }
  
  .sidebar-toggle-mobile .icon-close {
    display: none;
  }
  
  :global([data-sidebar-open]) .sidebar-toggle-mobile .icon-menu {
    display: none;
  }
  
  :global([data-sidebar-open]) .sidebar-toggle-mobile .icon-close {
    display: block;
  }
  
  @media (max-width: 1024px) {
    .sidebar-toggle-mobile {
      display: flex;
    }
  }
  
  @media (max-width: 640px) {
    .github-text {
      display: none;
    }
  }
  
  /* Sidebar expand button - shown when collapsed on desktop */
  .sidebar-expand-btn {
    display: none;
    position: fixed;
    left: 0;
    bottom: 1rem;
    z-index: 80;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: none;
    border-radius: 0 6px 6px 0;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  
  .sidebar-expand-btn:hover {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
  }
  
  :global([data-sidebar-collapsed]) .sidebar-expand-btn {
    display: flex;
  }
  
  @media (max-width: 1024px) {
    .sidebar-expand-btn {
      display: none !important;
    }
  }
  
  .footer {
    border-top: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    padding: 2rem 1.5rem;
    margin-top: auto;
  }
  
  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  
  .footer-content p {
    margin: 0.5rem 0;
  }
  
  .footer-disclaimer {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  
  .footer-hosted {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
  }
</style>
